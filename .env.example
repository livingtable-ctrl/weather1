# Kalshi API credentials
# Get these from: kalshi.com/account/profile -> API Keys -> Create New API Key
KALSHI_KEY_ID=your-key-id-here
KALSHI_PRIVATE_KEY_PATH=./kalshi_private_key.pem

# Set to "demo" to use the sandbox, "prod" for real money
KALSHI_ENV=demo

# Trading thresholds
MIN_EDGE=0.10
STRONG_EDGE=0.25
MAX_DAILY_LOSS_PCT=0.03
MAX_POSITION_AGE_DAYS=7

# Position limits (#42, #47)
# MIN_ORDER_COST is hardcoded at $0.05; MAX_SINGLE_TICKER_EXPOSURE is a fraction of starting balance
MAX_SINGLE_TICKER_EXPOSURE=0.10

# Betting strategy (#120): kelly | fixed_pct | fixed_dollars
STRATEGY=kelly
FIXED_BET_PCT=0.01       # used when STRATEGY=fixed_pct
FIXED_BET_DOLLARS=10.0   # used when STRATEGY=fixed_dollars

# Halt trading when balance drops to this fraction of peak. Default 0.20 (20%).
# Previous default was 0.50 — changed 2026-04-18 per code review.
DRAWDOWN_HALT_PCT=0.20

# Logging level (#106): DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=WARNING

# NWS User-Agent (#68): identifies your app to NOAA API
NWS_USER_AGENT=kalshi-weather-predictor/1.0 (user@localhost)

# Pirate Weather API key (fallback when Open-Meteo is unavailable)
# Free tier: 20,000 calls/month — get key at pirateweather.net
PIRATE_WEATHER_API_KEY=

# Discord notifications (optional, #92: comma-separate multiple webhooks)
DISCORD_WEBHOOK_URL=
DISCORD_WEBHOOK_URLS=   # comma-separated for multiple channels

# Notification channels (#123): comma-separated subset of: desktop,pushover,ntfy,discord,email
NOTIFY_CHANNELS=desktop,pushover,ntfy,discord,email

# Protect the web dashboard with HTTP Basic Auth (REQUIRED — the dashboard
# exposes kill switch and trade control endpoints). Leaving this empty makes
# the dashboard refuse to start unless DASHBOARD_UNPROTECTED=true is also set
# (dev/test only — see web_app.py's startup guard).
DASHBOARD_PASSWORD=
# DASHBOARD_UNPROTECTED=true

# Email notifications via SMTP (optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@email.com
SMTP_PASS=your_app_password
SMTP_TO=recipient@email.com

# Dead man's switch push notifications (optional, free — create a topic at https://ntfy.sh)
# NTFY_TOPIC=my_kalshi_bot_alerts

# Set to "true" to keep cron scanning/collecting data (forecasts, anomalies, caches)
# while skipping all trade placement, even paper. Useful when traveling somewhere
# Kalshi lists as a Restricted Jurisdiction for Event Contract trading.
TRADING_PAUSED=false

# How long (minutes) a live order whose placement outcome could not be
# determined stays in the recovery queue before the bot alerts an operator.
# An ENTRY order is then parked at the terminal status='unresolved' and is no
# longer re-checked; an EXIT order is alerted but deliberately keeps being
# retried, because abandoning it would orphan the position it was closing.
# Default 1440 (24h). Floored at 1; a non-numeric value falls back to 1440.
# See LIVE_TRADING_RUNBOOK.md.
# UNRESOLVED_ORDER_AGE_MINUTES=1440
